# Saudi Vision 2030 RAG - Environment Configuration Example

# Groq Cloud API Key for LLM Generation (allam-2-7b)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Qdrant Vector Database URL and API Key
QDRANT_URL="https://your-cluster.qdrant.tech:6333"
QDRANT_API_KEY="your_qdrant_api_key_here"

# Optional: Admin passphrase for endpoints that mutate the vector store (e.g. document deletion)
# Generate a secure one via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_PASSPHRASE="your_secure_passphrase"

# Optional: Disable HyDE for testing (defaults to true)
# USE_HYDE="true"
